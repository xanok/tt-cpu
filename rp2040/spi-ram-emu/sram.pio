; SPI slave
;
; Transfers to/from the CPU are a byte at a time
;
; Every clock a bit is read and a bit is written
; If no bytes are available to transmit, zeros are written
; 
; Read pins:
; IN:  0: MOSI
;      SRAM_SCK_OFS: SCK
;      SRAM_CS_OFS:  CS
; OUT: 0: MISO  (write SM only)
;
; cpu8 changes against upstream (MichaelBell/spi-ram-emu 7a46f8f):
; 1. Pin layout. Upstream wants SCK = MOSI+1 and CS = MOSI+2. On the TT demo
;    board cpu8 has CS=uio0, MOSI=uio1, MISO=uio2, SCK=uio3, i.e.
;    SCK = MOSI+2 and CS = MOSI-1. PIO "wait pin" indexes wrap modulo 32,
;    so CS is input pin index 31. sram.c checks these against pinmap.h.
; 2. MISO changes after the FALLING edge of SCK (like a real 23LC512),
;    not right after the rising edge. cpu8 samples MISO at the end of the
;    SCK high phase, so with the upstream timing it would read the NEXT bit.
;    This also gives the first data bit half an SCK period more time.
.define PUBLIC SRAM_SCK_OFS 2
.define PUBLIC SRAM_CS_OFS 31
.program sram_read
top:
    wait 0 pin SRAM_CS_OFS
    set x, 7
read_cmd_loop:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    in pins, 1
    jmp x--, read_cmd_loop
    wait 0 pin SRAM_SCK_OFS
    push
    in y, 16
    wait 1 pin SRAM_SCK_OFS
    in pins, 1
    set x, 12
read_addr_loop:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    in pins, 1
    jmp x--, read_addr_loop
    in null, 2
    set x, 1
read_addr_low_loop:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    in pins, 1
    jmp x--, read_addr_low_loop
    push
.wrap_target
    set x, 7
read_data_loop:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    in pins, 1
    jmp x--, read_data_loop
    push

; Crazy plan for unaligned read handling:
; - Data is DMA'd 32-bits at a time
; - On read side send first 30 bits of address (right justified), and then 2 bits end of address
; - Write side program also counts the cycles from the CS going low and then starts branching on the last 2 bits
; - The branch determines how many bits (24, 16, 8 or none) it throws away before outputting to pins

.program sram_write
    wait 0 pin SRAM_CS_OFS
    set x, 22
cmd_addr_loop:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    jmp x--, cmd_addr_loop
PUBLIC addr_loop_end:
    jmp pin, addr_two
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    jmp pin, addr_one
write_loop:
.wrap_target
    wait 0 pin SRAM_SCK_OFS     ; cpu8 change: shift out after the falling edge
    out pins, 1
    wait 1 pin SRAM_SCK_OFS
    jmp write_loop
PUBLIC addr_two:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    jmp pin, addr_three
    out null, 16
    jmp write_loop
addr_one:
    out null, 8
    jmp write_loop
addr_three:
    out null, 24
    jmp write_loop
PUBLIC fast_read:
    set x, 8
fast_read_loop:
    wait 0 pin SRAM_SCK_OFS
    wait 1 pin SRAM_SCK_OFS
    jmp x--, fast_read_loop
.wrap

% c-sdk {
// cpu8 change: pins are passed one by one (no consecutive-pin assumption)
// and stay SIO inputs: PIO can read any GPIO without owning it. MISO is
// handed to the PIO later by sram_drive_miso().
void sram_read_program_init(PIO pio, uint sm, uint offset, uint mosi, uint sck, uint cs) {
    gpio_init(mosi);
    gpio_init(sck);
    gpio_init(cs);
    gpio_set_pulls(mosi, false, false);
    gpio_set_pulls(sck, false, false);
    gpio_set_pulls(cs, true, false);   // idle deselected

    pio_sm_config c = sram_read_program_get_default_config(offset);
    sm_config_set_in_pins(&c, mosi);
    sm_config_set_in_shift(&c, false, true, 32);

    pio_sm_put(pio, sm, 0x2003);
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_exec(pio, sm, pio_encode_mov(pio_y, pio_osr));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

void sram_write_program_init(PIO pio, uint sm, uint offset, uint mosi, uint miso) {
    gpio_init(miso);  // input until sram_drive_miso(true)
    pio_sm_set_consecutive_pindirs(pio, sm, miso, 1, true);

    pio_sm_config c = sram_write_program_get_default_config(offset);
    sm_config_set_in_pins(&c, mosi);
    sm_config_set_out_pins(&c, miso, 1);
    sm_config_set_out_shift(&c, false, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_jmp_pin(&c, mosi);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
